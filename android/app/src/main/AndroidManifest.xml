<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- KRİTİK: Ağ Erişimi İzni. Flutter'ın debug/profile araç zinciri bu izni
         kendi ürettiği geçici manifestte OTOMATİK ekler; bu yüzden bilgisayara
         bağlı debug modda ağ istekleri (Supabase Edge Function / AI Koç dahil)
         sorunsuz çalışır. Ancak RELEASE APK yalnızca bu dosyayı kullanır — izin
         burada açıkça tanımlı olmazsa telefona kurulan gerçek APK'da HER türlü
         internet isteği sessizce başarısız olur. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Android 13+ Bildirim Çubuğu ve Kilit Ekranı İzni -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Ayarlar → Bildirimler: zamanlanmış "Günlük Hatırlatma" / "Seri Kaybı
         Uyarısı" bildirimleri AlarmManager ile kuruluyor. Android, cihaz
         yeniden başlatıldığında bekleyen tüm alarmları temizler; bu izin,
         ileride eklenebilecek bir BOOT_COMPLETED receiver'ının bunları
         otomatik yeniden kurabilmesi için şimdiden tanımlandı (receiver
         henüz eklenmedi — bkz. NotificationService dosya başı notu; şu an
         için tercihler her uygulama açılışında yeniden kuruluyor). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Arka Plan İzinleri -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- P0-D: audio_service paketi kod tabanında kullanılmıyor ama build
         kararlılığı nedeniyle pubspec.yaml'da tutuluyor (bkz. oradaki not) —
         bu izin ve aşağıdaki servis/receiver kaydı da o paketle birlikte
         geri kondu, tutarsız/eksik bir manifest durumuna düşmemek için. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- AŞAMA 1: Android Auto Backup — kullanıcı hesabı/bulut altyapısı
         kurmadan, ücretsiz olarak flashcards/XP/seri verisini kullanıcının
         kendi Google hesabına yedekler ve yeni cihaz/yeniden kurulumda
         otomatik geri yükler. allowBackup açıkça yazıldı (varsayılanı
         beklemek yerine); kitap metni (book_content.db) 25 MB kotayı
         doldurmasın diye iki kural dosyasıyla hariç tutuluyor — bkz.
         res/xml/backup_rules.xml (API 23-30) ve
         res/xml/data_extraction_rules.xml (API 31+). -->
    <application
        android:label="Ignis"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- P0-D: audio_service paketinin standart Android kurulum kaydı.
             Paket kod tabanında kullanılmıyor (tts_service.dart flutter_tts
             kullanıyor) ama build kararlılığı için pubspec.yaml'da tutuluyor
             (bkz. oradaki not) — bu servis/receiver kaydı, paketle tutarlı
             kalması için audio_service'in kendi kurulum talimatlarına göre
             yeniden eklendi. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>