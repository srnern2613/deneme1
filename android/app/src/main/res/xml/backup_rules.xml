<?xml version="1.0" encoding="utf-8"?>
<!--
  AŞAMA 1 — Android Auto Backup, API 23-30 (Android 12 öncesi) için eski
  şema. data_extraction_rules.xml ile AYNI hariç tutma mantığı; Android
  12'nin yeni dataExtractionRules şeması geriye dönük çalışmadığı için
  ikisi birlikte tutuluyor (Android'in kendi önerdiği çift tanım).
-->
<full-backup-content>
    <exclude domain="database" path="book_content.db" />
    <exclude domain="database" path="book_content.db-wal" />
    <exclude domain="database" path="book_content.db-shm" />
    <exclude domain="database" path="book_content.db-journal" />
</full-backup-content>
