<?xml version="1.0" encoding="utf-8"?>
<!--
  AŞAMA 1 — Android Auto Backup (Android 12 / API 31+).
  Kitap sayfa metinleri book_content.db'de tutuluyor ve BÜYÜK olabiliyor
  (birkaç roman kolayca birkaç MB); bu dosya bilerek yedekten ve cihazdan
  cihaza aktarımdan HARİÇ tutuluyor ki 25 MB'lık toplam kota flashcards,
  ilerleme ve daily_stats gibi asıl değerli veri için harcansın.

  Kitap metni kaybolursa kullanıcı kitabı yeniden açar/indirir; kelime
  ilerlemesi (uuid ile eşleşen flashcards, XP, seri) etkilenmez.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="book_content.db" />
        <exclude domain="database" path="book_content.db-wal" />
        <exclude domain="database" path="book_content.db-shm" />
        <exclude domain="database" path="book_content.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="book_content.db" />
        <exclude domain="database" path="book_content.db-wal" />
        <exclude domain="database" path="book_content.db-shm" />
        <exclude domain="database" path="book_content.db-journal" />
    </device-transfer>
</data-extraction-rules>
